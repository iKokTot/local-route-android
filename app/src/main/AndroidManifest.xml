<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <queries>
        <package android:name="com.google.android.youtube" />
        <package android:name="com.discord" />
        <package android:name="com.zhiliaoapp.musically" />
        <package android:name="com.instagram.android" />
        <package android:name="com.twitter.android" />
        <package android:name="com.openai.chatgpt" />
        <package android:name="org.telegram.messenger" />
    </queries>
    <application android:allowBackup="false" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher"
        android:label="Local Route" android:theme="@style/Theme.LocalRoute">
        <activity android:name=".MainActivity" android:exported="true"><intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter></activity>
        <service android:name=".localdpi.LocalDpiVpnService" android:permission="android.permission.BIND_VPN_SERVICE" android:exported="false" android:foregroundServiceType="specialUse">
            <intent-filter><action android:name="android.net.VpnService"/></intent-filter>
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="Локальная обработка трафика устройства без внешнего VPN-сервера"/>
        </service>
        <service android:name=".localdpi.LocalRouteTileService" android:exported="true"
            android:icon="@drawable/ic_local_route" android:label="Local Route"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE"/></intent-filter>
            <meta-data android:name="android.service.quicksettings.ACTIVE_TILE" android:value="true"/>
        </service>
        <service android:name="com.wireguard.android.backend.GoBackend$VpnService" android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE" android:foregroundServiceType="specialUse">
            <intent-filter><action android:name="android.net.VpnService"/></intent-filter>
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="Защищённый туннель к собственному серверу пользователя"/>
        </service>
        <service android:name=".tunnel.VlessVpnService" android:permission="android.permission.BIND_VPN_SERVICE" android:exported="false" android:foregroundServiceType="specialUse">
            <intent-filter><action android:name="android.net.VpnService"/></intent-filter>
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="Выборочный VLESS-туннель для явно выбранных приложений"/>
        </service>
    </application>
</manifest>
